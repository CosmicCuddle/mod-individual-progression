+    ObjectGuid const f14PreviousGuid = f14PreviousVictim ? f14PreviousVictim->GetGUID() : ObjectGuid::Empty;
+    ObjectGuid const f14CurrentGuid = victim->GetGUID();
     if (m_attacking)
@@ -7184,3 +7205,8 @@
