# Core F14 explicit REFRESH REQUEST prototype. Apply AFTER #56 + #67 + #76 patches.
# No listener requests it now: default false; no visibility denial or client ACK.
# Owner's single combined in-game test is still required before any live activation.
diff --git a/src/server/game/Scripting/ScriptDefines/UnitScript.h b/src/server/game/Scripting/ScriptDefines/UnitScript.h
--- a/src/server/game/Scripting/ScriptDefines/UnitScript.h
+++ b/src/server/game/Scripting/ScriptDefines/UnitScript.h
@@ -51,3 +51,4 @@
     UNITHOOK_ON_F14_CREATURE_RESPAWNED,
+    UNITHOOK_ON_F14_CREATURE_VISIBILITY_REFRESH_REQUEST,
     UNITHOOK_END
 };
@@ -121,3 +122,7 @@
     virtual void OnF14CreatureRespawned(Creature* /*creature*/) { }
+    // Set request=true only with a complete and current conceal/reveal proof.
+    // Called after the combat/corpse/respawn bookkeeping hook returned;
+    // its caller performs the refresh after this hook also returns.
+    virtual void OnF14CreatureVisibilityRefreshRequested(Creature const* /*creature*/, bool& /*request*/) { }
 };
diff --git a/src/server/game/Scripting/ScriptDefines/UnitScript.cpp b/src/server/game/Scripting/ScriptDefines/UnitScript.cpp
--- a/src/server/game/Scripting/ScriptDefines/UnitScript.cpp
+++ b/src/server/game/Scripting/ScriptDefines/UnitScript.cpp
@@ -156,3 +156,12 @@
         script->OnF14CreatureRespawned(creature));
 }
+bool ScriptMgr::ShouldF14RefreshCreatureVisibility(Creature const* creature)
+{
+    ASSERT(creature);
+    bool requested = false;
+    CALL_ENABLED_HOOKS(UnitScript, UNITHOOK_ON_F14_CREATURE_VISIBILITY_REFRESH_REQUEST,
+        script->OnF14CreatureVisibilityRefreshRequested(creature, requested));
+    return requested;
+}
 
diff --git a/src/server/game/Scripting/ScriptMgr.h b/src/server/game/Scripting/ScriptMgr.h
--- a/src/server/game/Scripting/ScriptMgr.h
+++ b/src/server/game/Scripting/ScriptMgr.h
@@ -588,3 +588,5 @@
     void OnF14CreatureRespawned(Creature* creature);
+    // Default FALSE unless a future reviewed F14 UnitScript requests a pass.
+    bool ShouldF14RefreshCreatureVisibility(Creature const* creature);
     void OnUnitSetShapeshiftForm(Unit* unit, uint8 form);
diff --git a/src/server/game/Entities/Unit/Unit.cpp b/src/server/game/Entities/Unit/Unit.cpp
--- a/src/server/game/Entities/Unit/Unit.cpp
+++ b/src/server/game/Entities/Unit/Unit.cpp
@@ -7085,3 +7085,24 @@
     return my_faction->IsNeutralToAll();
 }
+// Re-resolve GUIDs on the current map AFTER F14 script bookkeeping returns.
+// Never retain an old/new Unit pointer across callbacks, and never enter
+// visibility while the IP lifecycle mutex is held. The script request is
+// FALSE by default: no extra grid walk until independently authorised.
+static void F14MaybeRefreshCreatureVisibility(Unit* attacker, ObjectGuid const& targetGuid)
+{
+    if (!attacker || !attacker->IsInWorld() || !targetGuid.IsAnyTypeCreature())
+        return;
+    Map* map = attacker->FindMap();
+    if (!map)
+        return;
+    Creature* target = map->GetCreature(targetGuid);
+    if (!target || !target->IsInWorld() || target->IsPet())
+        return;
+    if (!sScriptMgr->ShouldF14RefreshCreatureVisibility(target))
+        return;
+    target->UpdateObjectVisibility(true);
+}
 
@@ -7179,3 +7200,9 @@
     sScriptMgr->OnF14AttackTargetTransition(this, f14PreviousVictim, victim);
+    // The observer hook has returned; re-resolve targets from GUIDs before
+    // requesting any viewer pass. Old target must reappear on target switch.
+    F14MaybeRefreshCreatureVisibility(this, f14PreviousVictim ? f14PreviousVictim->GetGUID() : ObjectGuid::Empty);
+    if (!f14PreviousVictim || f14PreviousVictim != victim)
+        F14MaybeRefreshCreatureVisibility(this, victim->GetGUID());
 
@@ -7261,3 +7288,6 @@
     sScriptMgr->OnF14AttackTargetTransition(this, victim, nullptr);
+    // Request visibility only AFTER the registry's attack-stop callback.
+    F14MaybeRefreshCreatureVisibility(this, victim->GetGUID());
 
diff --git a/src/server/game/Entities/Creature/Creature.cpp b/src/server/game/Entities/Creature/Creature.cpp
--- a/src/server/game/Entities/Creature/Creature.cpp
+++ b/src/server/game/Entities/Creature/Creature.cpp
@@ -2011,3 +2011,6 @@
         sScriptMgr->OnF14CreatureCorpseReady(this);
+        // Corpse loot/quest rights require restoring the viewer's object.
+        if (IsInWorld() && !IsPet() && sScriptMgr->ShouldF14RefreshCreatureVisibility(this))
+            UpdateObjectVisibility(true);
     }
@@ -2043,3 +2046,6 @@
         sScriptMgr->OnF14CreatureRespawned(this);
+        // Respawn changes the incarnation; re-evaluate nearby viewers if
