+    // The observer hook has returned; re-resolve targets from GUIDs before
+    // requesting any viewer pass. Old target must reappear on target switch.
+    F14MaybeRefreshCreatureVisibility(this, f14PreviousGuid);
+    if (f14PreviousGuid != f14CurrentGuid)
+        F14MaybeRefreshCreatureVisibility(this, f14CurrentGuid);
