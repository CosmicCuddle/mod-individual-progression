+++ b/src/server/game/Scripting/ScriptDefines/UnitScript.h
@@ -51,3 +51,4 @@
     UNITHOOK_ON_F14_CREATURE_RESPAWNED,
+    UNITHOOK_ON_F14_CREATURE_VISIBILITY_REFRESH_REQUEST,
     UNITHOOK_END
 };
@@ -121,2 +122,6 @@
     virtual void OnF14CreatureRespawned(Creature* /*creature*/) { }
+    // Return true only with a complete and current conceal/reveal proof.
+    // Default FALSE; this script hook is called only after the previous
+    // combat/corpse/respawn bookkeeping hook has returned.
+    [[nodiscard]] virtual bool OnF14ShouldRefreshCreatureVisibility(Creature const* /*creature*/) { return false; }
 };
diff --git a/src/server/game/Scripting/ScriptDefines/UnitScript.cpp b/src/server/game/Scripting/ScriptDefines/UnitScript.cpp
