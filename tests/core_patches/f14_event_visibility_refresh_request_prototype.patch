+++ b/src/server/game/Scripting/ScriptDefines/UnitScript.cpp
@@ -156,3 +156,9 @@
         script->OnF14CreatureRespawned(creature));
 }
+bool ScriptMgr::ShouldF14RefreshCreatureVisibility(Creature const* creature)
+{
+    ASSERT(creature);
+    CALL_ENABLED_BOOLEAN_HOOKS_WITH_DEFAULT_FALSE(UnitScript, UNITHOOK_ON_F14_CREATURE_VISIBILITY_REFRESH_REQUEST,
+        script->OnF14ShouldRefreshCreatureVisibility(creature));
+}
