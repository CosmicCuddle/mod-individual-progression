+void ScriptMgr::OnF14ViewerTargetLinkChanged(Player const* observer, WorldObject const* target, bool nowLinked, bool batched)
+{
+    ASSERT(observer && target);
+    CALL_ENABLED_HOOKS(WorldObjectScript, WORLDOBJECTHOOK_ON_F14_VIEWER_TARGET_LINK_CHANGED,
+        script->OnF14ViewerTargetLinkChanged(observer, target, nowLinked, batched));
+}
