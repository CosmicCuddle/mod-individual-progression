@@ -33,3 +33,4 @@
     WORLDOBJECTHOOK_ON_F14_VISIBILITY_REEVALUATION_PROCESSED,
+    WORLDOBJECTHOOK_ON_F14_VIEWER_TARGET_LINK_CHANGED,
     WORLDOBJECTHOOK_END
 };
@@ -101,4 +102,10 @@
     virtual void OnF14VisibilityReevaluationProcessed(WorldObject const* /*object*/, bool /*playerFrame*/) { }
+
+    // Called after server-side per-viewer object link changes.
+    // batched=true: only queued UpdateData (not yet packet delivery).
+    // Never mutate a target or recurse into visibility here.
+    virtual void OnF14ViewerTargetLinkChanged(Player const* /*observer*/, WorldObject const* /*target*/,
+                                             bool /*nowLinked*/, bool /*batched*/) { }
 };
 
 #endif
