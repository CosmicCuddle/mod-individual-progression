+    // Protect the paid receipt row from Core's permissive parser: silently
+    // skipping invalid tokens can shift a malformed row into a valid paid
+    // entitlement when a subsequent character save serializes the cache.
+    // This source-specific guard does not alter existing settings providers.
+    static bool IsCanonicalPaidReceiptRow(std::string const& source, std::string const& data)
