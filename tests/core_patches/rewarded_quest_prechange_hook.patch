 void Player::SetRewardedQuest(uint32 quest_id)
 {
+    if (m_RewardedQuests.find(quest_id) == m_RewardedQuests.end())
+        sScriptMgr->OnPlayerBeforeRewardedQuestChange(this, quest_id, true);
     m_RewardedQuests.insert(quest_id);
     m_RewardedQuestsSave[quest_id] = true;
 }
@@ -1589,7 +1591,9 @@ void Player::RemoveRewardedQuest(uint32 questId, bool update /*= true*/)
     RewardedQuestSet::iterator rewItr = m_RewardedQuests.find(questId);
     if (rewItr != m_RewardedQuests.end())
     {
-        m_RewardedQuests.erase(rewItr);
+        sScriptMgr->OnPlayerBeforeRewardedQuestChange(this, questId, false);
+        // Handlers must not mutate the set; erase by key so a stale iterator is never used.
+        m_RewardedQuests.erase(questId);
         m_RewardedQuestsSave[questId] = false;
     }
 
